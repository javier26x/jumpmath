rules_version = '2';

// Cada docente escribe sólo bajo su propio uid, y sólo si su cuenta está
// autorizada. Se acotan tipo y tamaño en la regla y no sólo en la interfaz: el
// Paso 1 es una página web y cualquiera puede llamar al endpoint por fuera.
//
// La lista de acceso se repite aquí y en firestore.rules porque cada servicio
// evalúa las suyas; `tests/` comprueba que no se separen de las funciones.
service firebase.storage {
  match /b/{bucket}/o {

    function autorizado() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email.lower() in ['javier.neo@gmail.com']
          || request.auth.token.email.lower().matches('.*@jumpmath[.]cl')
        );
    }

    match /cursos/{uid}/{cursoId}/{ranura}/{archivo} {

      function esDuenio() {
        return autorizado() && request.auth.uid == uid;
      }

      function ranuraValida() {
        return ranura in ['dia_oficial', 'estudiantes', 'recomendaciones',
                          'seguimiento', 'plan_anual'];
      }

      function tipoValido() {
        return request.resource.contentType.matches('application/pdf')
          || request.resource.contentType.matches(
               'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet')
          || request.resource.contentType.matches('application/vnd.ms-excel')
          || request.resource.contentType.matches('text/csv');
      }

      allow read, delete: if esDuenio();
      allow write: if esDuenio()
        && ranuraValida()
        && tipoValido()
        && request.resource.size < 25 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
